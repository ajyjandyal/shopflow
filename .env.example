# Copy this file to .env and fill in real values.  NEVER commit .env.
# Keep comments on their own lines: inline comments become part of the value.

# --- PostgreSQL (used by docker-compose AND the Spring app) ---
DB_NAME=shopflow
DB_USERNAME=shopflow
DB_PASSWORD=change-me-local-only
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/shopflow

# --- JWT ---
# Generate with:  openssl rand -base64 32
# Must decode to at least 32 bytes (256 bits) for HS256.
JWT_SECRET=
# ISO-8601 duration: PT1H = 1 hour, PT15M = 15 minutes
JWT_EXPIRATION=PT1H

# --- CORS (comma-separated list of frontend origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Bootstrap admin account (created on startup if it does not exist) ---
# Leave ADMIN_PASSWORD empty to skip. Minimum 12 characters.
ADMIN_EMAIL=admin@shopflow.local
ADMIN_PASSWORD=


# --- Service-to-service authentication (Phase 2) ---
# Generate with:  openssl rand -hex 32
INTERNAL_API_KEY=

# --- Ports and URLs (defaults shown; change only if a port is busy) ---
# GATEWAY_PORT=8080
# USER_SERVICE_PORT=8081
# PRODUCT_SERVICE_PORT=8082
# ORDER_SERVICE_PORT=8083
# USER_DB_URL=jdbc:postgresql://localhost:5432/shopflow_users
# PRODUCT_DB_URL=jdbc:postgresql://localhost:5432/shopflow_products
# ORDER_DB_URL=jdbc:postgresql://localhost:5432/shopflow_orders
